INSIGHT_WX_CHANNEL_BASE_URL=http://host.docker.internal:2026
INSIGHT_DEFAULT_HUB_USER_ID=insight:operator:local
INSIGHT_POSTGRES_PASSWORD=replace-with-a-random-password
INSIGHT_TRUSTED_BRIDGE_TOKEN=replace-with-a-random-bridge-token
INSIGHT_AI_CONFIG_ENCRYPTION_KEY=replace-with-64-hex-characters
INSIGHT_CORS_ORIGINS=http://127.0.0.1:5176,http://localhost:5176
INSIGHT_DEFAULT_DEVICE_COUNT=1
INSIGHT_EDGE_WS_ENABLED=true
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6
OPENAI_TIMEOUT_SECONDS=45
# Set OPENAI_API_KEY locally; do not commit a real key.
