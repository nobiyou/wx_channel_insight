{
  "server": {
    "addr": "127.0.0.1:18081",
    "web_static_root": "apps/web/dist",
    "cors_origins": ["http://127.0.0.1:5176", "http://localhost:5176"]
  },
  "runtime": {
    "default_hub_user_id": "insight:operator:local",
    "default_device_count": 1
  },
  "storage": {
    "driver": "sqlite",
    "data_dir": "var",
    "sqlite_path": "var/insight.db"
  },
  "wx_channel": {
    "base_url": "http://127.0.0.1:2026",
    "comment_data_root": ""
  },
  "bridge": {
    "local_operator": true,
    "require_trusted_for_live": true,
    "demo_context_enabled": false
  },
  "edge": {
    "enabled": false
  },
  "openai": {
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-5.6",
    "timeout_seconds": 45
  },
  "scheduler": {
    "api_base_url": "http://127.0.0.1:18081",
    "poll_interval": "15s",
    "request_timeout": "10m"
  }
}
